// ============================================================================
// Windows 资源脚本：程序图标 + 版本信息
//
// 注意：图标路径使用**相对路径**（qmake 生成的 windres 命令行带 --include-dir=.，
// 而 qmake 会把本文件复制到构建目录再编译，因此相对 .rc 文件自身即可定位）。
// 旧版本这里写的是绝对路径 "C:\\VD\\Projects\\BattleForFuture\\WindowIcon.ico"，
// 换机器 / 换目录 / 在 Linux 上编译都会直接失败。
// ============================================================================
#include <windows.h>

IDI_ICON1  ICON  "WindowIcon.ico"

VS_VERSION_INFO VERSIONINFO
	FILEVERSION 2,2,0,0
	PRODUCTVERSION 2,2,0,0
	FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
	FILEFLAGS VS_FF_DEBUG
#else
	FILEFLAGS 0x0L
#endif
	FILEOS VOS_NT_WINDOWS32
	FILETYPE VFT_APP
	FILESUBTYPE VFT2_UNKNOWN
	BEGIN
		BLOCK "StringFileInfo"
		BEGIN
			BLOCK "040904b0"
			BEGIN
				VALUE "CompanyName", "Explorer\0"
				VALUE "FileDescription", "BattleForFuture - 高考倒计时\0"
				VALUE "FileVersion", "2.2.0.0\0"
				VALUE "LegalCopyright", "\0"
				VALUE "OriginalFilename", "BattleForFuture.exe\0"
				VALUE "ProductName", "BattleForFuture\0"
				VALUE "ProductVersion", "2.2.0.0\0"
				VALUE "InternalName", "BattleForFuture\0"
				VALUE "Comments", "Gaokao countdown widget for students\0"
				VALUE "LegalTrademarks", "\0"
			END
		END
		BLOCK "VarFileInfo"
		BEGIN
			VALUE "Translation", 0x0409, 1200
		END
	END
/* End of Version info */
